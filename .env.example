# URL du webhook Discord (Parametres du salon > Intégrations > Webhooks)
WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Chemin absolu vers le fichier CSV des contacts
DATA_FILE=C:\Scripts\birthday-bot\contacts_data.csv

# Fuseau horaire Windows (defaut : Romance Standard Time = Paris)
TIMEZONE=Romance Standard Time

# Token du bot Discord (discord.com/developers/applications)
BOT_TOKEN=VOTRE_TOKEN_ICI
